<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiler truth for the C# benchmarks: the call graph as Roslyn binds it (bench/roslyn_truth/README.md). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynVersion)" />
  </ItemGroup>
  <PropertyGroup>
    <RoslynVersion Condition="'$(RoslynVersion)' == ''">5.0.0</RoslynVersion>
  </PropertyGroup>
</Project>
