[Unit]
Description=devkb triage of new outside issues and pull requests (Claude CLI, signed-in session)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/devkb-triage.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n %h/.cache/devkb-triage.lock python3 @SCRIPT@ triage
Nice=10
TimeoutStartSec=1h
